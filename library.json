{
  "name": "ESP32_Hardware",
  "version": "1.0.0",
  "description": "Library for common hardware mounted on PAMI and main robot",
  "keywords": [
    "esp32",
    "hardware",
    "robotics",
    "pami",
    "servo",
    "screen",
    "IHM",
    "INA219"
  ],
  "homepage": "https://github.com/Mecapitronic/ESP32_Hardware",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mecapitronic/ESP32_Hardware.git"
  },
  "authors": [
    {
      "name": "Mecapitronic",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "frameworks": [
    "arduino"
  ],
  "platforms": [
    "espressif32"
  ],
  "dependencies": [
    {
      "owner": "greiman",
      "name": "SSD1306Ascii",
      "version": "^1.3.5"
    },
    {
      "owner": "adafruit",
      "name": "Adafruit INA219",
      "version": "^1.2.3"
    },
    {
      "owner": "fastled",
      "name": "FastLED",
      "version": "3.9.16"
    },
    {
      "owner": "stm32duino",
      "name": "STM32duino VL53L8CX",
      "version": "^2.0.3"
    }
  ],
  "build": {
    "includeDir": "include",
    "srcDir": "src",
    "flags": ["-I config"]
  }
}